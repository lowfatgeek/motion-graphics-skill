{
  "root": ".",
  "manifest": "manifest.json",
  "_readme": [
    "Source of truth for the Motion Bang Bang SFX bundle. Edit a prompt here, then run:",
    "  python scripts/elevenlabs_audio.py sfx --spec assets/sfx/library.json --preview _preview.wav",
    "Existing files are skipped unless --force is given, so this doubles as an extend-the-library recipe.",
    "duration_seconds is what you are billed for, not what you keep: 'tight' one-shots are",
    "silence-trimmed afterwards, so request a little headroom and let the trim decide the length.",
    "Prompts always name source + surface + mic perspective, and forbid musical content, because",
    "a tonal stinger collides with any music bed added later."
  ],
  "mix": {
    "_note": "Relative to each asset's normalised -3 dBFS peak. Intensity is a mix-time parameter: every file in the bundle sits at the same peak on purpose, so a library click and a library impact differ only by what the mixer applies.",
    "impact": {
      "gain_db": -6,
      "max_hits_per_s": 2,
      "duck_under_speech": false
    },
    "stamp": {
      "gain_db": -9,
      "max_hits_per_s": 2,
      "duck_under_speech": false
    },
    "whoosh": {
      "gain_db": -10,
      "max_hits_per_s": 1.5,
      "duck_under_speech": true
    },
    "transition": {
      "gain_db": -11,
      "max_hits_per_s": 0.2,
      "duck_under_speech": false
    },
    "accent": {
      "gain_db": -12,
      "max_hits_per_s": 1,
      "duck_under_speech": false
    },
    "paper": {
      "gain_db": -13,
      "max_hits_per_s": 2,
      "duck_under_speech": true
    },
    "pen": {
      "gain_db": -14,
      "max_hits_per_s": 1.5,
      "duck_under_speech": true
    },
    "ui": {
      "gain_db": -18,
      "max_hits_per_s": 3,
      "duck_under_speech": true
    },
    "ambience": {
      "gain_db": -30,
      "max_hits_per_s": 0,
      "duck_under_speech": false,
      "continuous": true
    }
  },
